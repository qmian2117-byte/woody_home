# ==============================================================================
# WOODY HOME — UNIFIED ENVIRONMENT CONFIGURATION TEMPLATE
# Copy these values into Vercel Project Settings > Environment Variables
# ==============================================================================

# ── 1. Storefront & Brand Config ──
NEXT_PUBLIC_SITE_NAME="Woody Home"
NEXT_PUBLIC_WHATSAPP="923326457322"
WHATSAPP_PHONE=923326457322

# ── 2. Server & API Endpoints ──
PORT=5000
NODE_ENV=production
FRONTEND_URL=http://localhost:3000
# On Vercel: Set NEXT_PUBLIC_API_URL to your deployed backend URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ── 3. Supabase Database & Auth ──
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# ── 4. Stripe Payment Processing ──
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── 5. Analytics & Meta Tracking (Optional) ──
META_PIXEL_ID=your-meta-pixel-id
META_ACCESS_TOKEN=your-meta-access-token
