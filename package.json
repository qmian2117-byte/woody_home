{
  "name": "woodyhome-backend",
  "version": "1.0.0",
  "description": "Custom Node.js & Supabase Backend for Woody Home Next.js Frontend",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:backend": "node --watch src/server.js",
    "dev:frontend": "npm run dev --prefix Site_project",
    "build:frontend": "npm run build --prefix Site_project",
    "start:frontend": "npm run start --prefix Site_project",
    "test": "node --test test",
    "test:unit": "node --test test/api-response.unit.test.js",
    "test:integration": "node --test test/api.integration.test.js"
  },
  "keywords": [
    "nodejs",
    "express",
    "supabase",
    "ecommerce",
    "nextjs-backend",
    "cart",
    "checkout",
    "cod",
    "mcp"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "stripe": "^23.0.0",
    "zod": "^3.24.2"
  }
}
